# ---- Database (Prisma reads DB_URL) ----
# docker compose exposes Postgres on 5433 so it won't clash with a local Postgres.
DB_URL=postgresql://driftboard:driftboard@localhost:5433/driftboard
DB_URL_UNPOOLED=postgresql://driftboard:driftboard@localhost:5433/driftboard
# ---- Better Auth ----
# Long random string used to sign session cookies. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-0123456789
# Public URL of the API (where /api/auth/* lives)
BETTER_AUTH_URL=http://localhost:8787

# ---- JWT (short-lived WebSocket tokens, HS256) ----
# Generate: openssl rand -base64 32
JWT_SECRET=change-me-jwt-secret-0123456789

# ---- Server ----
PORT=8787
# Frontend origin, for CORS and Better Auth trusted origins
WEB_ORIGIN=http://localhost:3000

# ---- Web (copy to apps/web/.env.local) ----
NEXT_PUBLIC_API_URL=http://localhost:8787
