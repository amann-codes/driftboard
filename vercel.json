{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "server": {
            "root": "apps/server",
            "framework": "hono"
        },
        "web": {
            "root": "apps/web",
            "framework": "nextjs"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "server"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "web"
            }
        }
    ]
}